<Window x:Class="DialedApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialed"
        Width="1080"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        Background="#0C0D10"
        Foreground="#F7F7F8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0C0F" Offset="0"/>
            <GradientStop Color="#11131A" Offset="0.58"/>
            <GradientStop Color="#0C0D10" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#DCDDE3" Offset="0.48"/>
            <GradientStop Color="#A9ACB8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBrush" Color="#15171D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B1E26"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#292C35"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F7F7F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8F949F"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#111216"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,13"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.22" Color="#FFFFFF"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.025" ScaleY="1.025"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#242832"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#474C58"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.018" ScaleY="1.018"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB2BC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#1D2027"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverCard" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.10" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3C414C"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.008" ScaleY="1.008"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.22" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeEntrance" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="18"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.42"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="18"
                                             To="0"
                                             Duration="0:0:0.48">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#EDEEF1"/>
            <Setter Property="Background" Value="#343740"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid Margin="38,28,38,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="11"
                            Background="{StaticResource AccentGradient}"
                            VerticalAlignment="Center">
                        <TextBlock Text="D"
                                   Foreground="#111216"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="dialed"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock Text="COLOUR MEMORY"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Background="#15171C"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#6BE3A5"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="OFFLINE"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Stats"
                            Style="{StaticResource TextButton}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="HeaderText"
                       Grid.Row="1"
                       Visibility="Collapsed"/>

            <Grid Grid.Row="2">
                <StackPanel x:Name="MenuPanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource HomeEntrance}">

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,0,0,8">
                        <TextBlock Text="SEE IT."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.9"/>
                        <TextBlock Text="REMEMBER IT."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"
                                   Opacity="0.9"/>
                        <TextBlock Text="DIALED."
                                   FontSize="48"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Humans can't reliably recall colours."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid MaxWidth="880"
                          Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.65*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#15171D"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="28"
                                Style="{StaticResource HoverCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="SOLO"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="Train your eye."
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="Memorize a colour, rebuild it from memory, and see how close you got."
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="470"
                                                   LineHeight="18"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#1C1F27"
                                            BorderBrush="#333741"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="9,6">
                                        <TextBlock Text="5 ROUNDS"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#D7DAE1"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,20,0,20">
                                    <Ellipse Width="190"
                                             Height="190"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Opacity="0.9">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#D0D2D9" Offset="0.35"/>
                                                <GradientStop Color="#6A6E79" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="158"
                                             Height="158"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="#111318"/>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="START"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="5"
                                                   FontSize="50"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,-7,0,-2"/>
                                        <TextBlock Text="colours"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="PLAY SOLO"
                                        Grid.Row="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="Solo_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="#15171D"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="22"
                                    Style="{StaticResource HoverCard}">
                                <StackPanel>
                                    <TextBlock Text="DAILY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="One shot."
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="One daily colour set. Same challenge, once per day."
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="17"
                                               Margin="0,6,0,14"/>
                                    <Button Content="PLAY DAILY"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="Daily_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#15171D"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="22"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource HoverCard}">
                                <StackPanel>
                                    <TextBlock Text="YOUR RECORD"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="StatsText"
                                               Text="Games: 0   Best: — / 50"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Margin="0,9,0,0"/>
                                    <TextBlock Text="Stored locally on this device."
                                               FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid MaxWidth="880"
                          Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#13151A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="15"
                                Style="{StaticResource HoverCard}">
                            <StackPanel>
                                <TextBlock Text="01"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Look"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Focus on hue, saturation and brightness."
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#13151A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="15"
                                Style="{StaticResource HoverCard}">
                            <StackPanel>
                                <TextBlock Text="02"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Recall"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="The colour disappears after the countdown."
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Background="#13151A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="15"
                                Style="{StaticResource HoverCard}">
                            <StackPanel>
                                <TextBlock Text="03"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Dial in"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Use the three controls to recreate it."
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Private · Offline · No account required"
                               FontSize="10"
                               Foreground="#686D77"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                </StackPanel>

                <StackPanel x:Name="MemorizePanel"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border x:Name="TargetSwatch" Height="340" CornerRadius="16"/>
                    <TextBlock x:Name="CountdownText"
                               FontSize="44"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,16"/>
                </StackPanel>

                <StackPanel x:Name="GuessPanel"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border x:Name="GuessSwatch" Height="240" CornerRadius="16" Margin="0,0,0,20"/>
                    <TextBlock Text="Hue"/>
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="180"
                            Style="{StaticResource SliderStyle}"
                            ValueChanged="Slider_Changed"/>
                    <TextBlock Text="Saturation" Margin="0,8,0,0"/>
                    <Slider x:Name="SatSlider" Minimum="0" Maximum="100" Value="50"
                            Style="{StaticResource SliderStyle}"
                            ValueChanged="Slider_Changed"/>
                    <TextBlock Text="Brightness" Margin="0,8,0,0"/>
                    <Slider x:Name="BriSlider" Minimum="0" Maximum="100" Value="50"
                            Style="{StaticResource SliderStyle}"
                            ValueChanged="Slider_Changed"/>
                    <Button Content="Confirm"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,20,0,0"
                            Click="Confirm_Click"/>
                </StackPanel>

                <StackPanel x:Name="RevealPanel"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Grid Height="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RevealTarget" Grid.Column="0" CornerRadius="16,0,0,16"/>
                        <Border x:Name="RevealGuess" Grid.Column="1" CornerRadius="0,16,16,0"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Target" HorizontalAlignment="Left" Opacity=".6"/>
                        <TextBlock Text="Yours" HorizontalAlignment="Right" Opacity=".6"/>
                    </Grid>
                    <TextBlock x:Name="ScoreText"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"/>
                    <TextBlock x:Name="DetailText"
                               HorizontalAlignment="Center"
                               Opacity=".6"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Button x:Name="NextBtn"
                            Content="Next"
                            Style="{StaticResource PrimaryButton}"
                            Click="Next_Click"/>
                </StackPanel>

                <StackPanel x:Name="FinalPanel"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="FinalScore"
                               FontSize="64"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FinalDetail"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Opacity=".7"
                               Margin="0,8,0,24"/>
                    <Button Content="Menu"
                            Style="{StaticResource SecondaryButton}"
                            Click="Menu_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
